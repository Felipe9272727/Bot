# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).

# --- Conta MetaTrader 5 (comece SEMPRE com conta DEMO) ---
MT5_LOGIN=00000000
MT5_PASSWORD=sua_senha_demo
MT5_SERVER=NomeDaCorretora-Demo
# Caminho do terminal (opcional; se vazio, usa o MT5 padrão instalado)
MT5_PATH=

# --- Operação ---
SYMBOLS=EURUSD,GBPUSD          # separados por vírgula
TIMEFRAME=H1                    # timeframe de execução
HTF_TIMEFRAME=D1                # timeframe maior (viés de tendência)
MAGIC=20240602
DRY_RUN=true                    # true = paper/log-only (não envia ordem). MUDE p/ false com cuidado.
USE_AI=false                    # Modo A: true = IA de notícias decide a direção

# --- Risco ---
RISK_PERCENT=1.0                # % do saldo arriscado por trade
ATR_SL_MULT=1.8                 # Stop Loss = ATR_SL_MULT x ATR
TP_R_MULTIPLE=1.0               # TP1 em múltiplos de R (1R)
PARTIAL_CLOSE_PCT=50            # % fechado no TP1
BREAKEVEN_BUFFER_ATR=0.2        # buffer do breakeven (x ATR)
TRAILING_ATR_MULT=2.5           # trailing Chandelier (x ATR)
MAX_OPEN_TRADES=1
MAX_DAILY_LOSS_PCT=5.0          # perda diária máx que pausa o bot
MAX_DRAWDOWN_PCT=15.0           # drawdown global máx que desliga o bot
MAX_CONSEC_LOSSES=4             # perdas seguidas que pausam no dia

# --- Sessão de operação (hora do servidor da corretora) ---
USE_SESSION_FILTER=true
SESSION_START_HOUR=13
SESSION_END_HOUR=17

# --- IA de notícias (opcional, plugar depois) ---
NEWS_API_KEY=
LLM_API_KEY=
